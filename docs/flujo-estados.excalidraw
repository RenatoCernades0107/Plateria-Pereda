      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Rechazado y No tiene arreglo: si la pieza está en la tienda,\n«Devolver al cliente» la deja en ubicación Entregada (sin cambiar el estado).",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "c_dev",
      "originalText": "Rechazado y No tiene arreglo: si la pieza está en la tienda,\n«Devolver al cliente» la deja en ubicación Entregada (sin cambiar el estado).",
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "c_note",
      "type": "rectangle",
      "x": 1500,
      "y": 1940,
      "width": 380,
