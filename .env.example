# Copia este archivo como .env.local. Con Supabase local corriendo (`pnpm db:start`),
# `pnpm env:local` completa automáticamente las tres variables de Supabase.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Shopify (fake = adaptador en memoria; live = tienda real o de desarrollo)
SHOPIFY_MODE=fake
SHOPIFY_STORE_DOMAIN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Versión fija de la Admin API y de los webhooks (se actualiza a propósito, no sola).
SHOPIFY_API_VERSION=2026-10

# App
CRON_SECRET=
APP_URL=http://localhost:3000
APP_TIMEZONE=America/Lima

# Notificaciones push de las alertas (opcional; las tres juntas).
# Se generan con `pnpm dlx web-push generate-vapid-keys`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto para el servicio de push: mailto:correo@dominio o la URL del sistema.
VAPID_SUBJECT=
